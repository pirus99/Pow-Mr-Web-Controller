# ── Serial / PowMr ────────────────────────────────────────────────────────────
SERIAL_PORT=/dev/ttyUSB1
SERIAL_BAUD=2400

# ── Prometheus data sources ───────────────────────────────────────────────────
BATTERY_URL=http://localhost:8000/metrics
SOLAX_URL=http://localhost:9000/metrics

# ── Web interface ─────────────────────────────────────────────────────────────
WEB_HOST=0.0.0.0
WEB_PORT=5000

# ── Prometheus metrics export (for Grafana) ───────────────────────────────────
METRICS_HOST=0.0.0.0
METRICS_PORT=8002

# ── Data polling interval (seconds) ──────────────────────────────────────────
POLL_INTERVAL=15

# ── Request timeout for Prometheus endpoints (seconds) ───────────────────────
FETCH_TIMEOUT=5

# ── Flask secret key (change this!) ──────────────────────────────────────────
SECRET_KEY=change-me-please
